OPENROUTER_API_KEY=your_openrouter_key_here
TAVILY_API_KEY=your_tavily_key_here

# Optional model overrides
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_EXTRACTION=openai/gpt-4o-mini
OPENROUTER_MODEL_ANALYSIS=openai/gpt-4o-mini
OPENROUTER_MODEL_RESEARCH=openai/gpt-4o-mini
OPENROUTER_MODEL_ADVISOR=openai/gpt-4o-mini

# Optional metadata for OpenRouter analytics
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=AIP444 Assignment 2 Job Search Assistant

# Optional runtime guardrails
RUN_COST_BUDGET_USD=2
MAX_TOOL_STEPS=4
TAVILY_MAX_RESULTS=5
LOG_LEVEL=info
